RESEARCH_STORE=json
RESEARCH_DATA_DIR=data/tmp
RESEARCH_EMBEDDING_PROVIDER=openai
RESEARCH_EMBEDDING_MODEL=text-embedding-3-small
RESEARCH_BROWSER_PROVIDER=none
RESEARCH_BROWSER_TIMEOUT=30
RESEARCH_BROWSER_MAX_ACTIONS=5
RESEARCH_BROWSER_MAX_PAGES=3
RESEARCH_BROWSER_MAX_DOWNLOAD_MB=25
RESEARCH_UNPAYWALL_EMAIL=
RESEARCH_EMBEDDING_CHUNK_TOKENS=768
RESEARCH_EMBEDDING_CHUNK_OVERLAP=96
RESEARCH_EMBEDDING_CHUNK_HARD_MAX=1024
RESEARCH_EMBEDDING_BATCH_TOKENS=16000
RESEARCH_SOURCE_PASSAGES_PER_PROPOSITION=3
RESEARCH_SOURCE_PASSAGE_CAP=32
OPENAI_API_KEY=replace-me
RESEARCH_REASONING_PROVIDER=deepseek
RESEARCH_SEARCH_PROVIDER=hybrid
DEEPSEEK_API_KEY=replace-me
RESEARCH_DEEPSEEK_MODEL=deepseek-v4-pro
RESEARCH_DEEPSEEK_THINKING=true
RESEARCH_DEEPSEEK_REASONING_EFFORT=high
RESEARCH_DEEPSEEK_BASE_URL=https://api.deepseek.com
RESEARCH_DEEPSEEK_TIMEOUT=300
RESEARCH_DEEPSEEK_MAX_ATTEMPTS=3
RESEARCH_DEBUG_RAW_RESPONSES=true
RESEARCH_DEBUG_DIR=data/tmp/debug
RESEARCH_CODEX_EXECUTABLE=codex
RESEARCH_CODEX_TIMEOUT=300



