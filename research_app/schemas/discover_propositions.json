{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["propositions"],
  "properties": {
    "propositions": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "polarity", "scope", "search_queries", "classification", "rationale", "source_id", "chunk_id"],
        "properties": {
          "text": {"type": "string"},
          "polarity": {"enum": ["supports_thesis", "challenges_thesis", "neutral"]},
          "scope": {"type": "object"},
          "search_queries": {"type": "array", "items": {"type": "string"}},
          "classification": {"enum": ["duplicate", "refinement", "novel", "contradiction"]},
          "rationale": {"type": "string"},
          "source_id": {"type": "string"},
          "chunk_id": {"type": "string"}
        }
      }
    }
  }
}
