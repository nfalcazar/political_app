{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["propositions"],
  "properties": {
    "propositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "text", "kind", "polarity", "scope", "search_queries"],
        "properties": {
          "key": {"type": "string"},
          "text": {"type": "string"},
          "kind": {"enum": ["empirical", "normative"]},
          "polarity": {"enum": ["supports_thesis", "challenges_thesis", "neutral"]},
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["geography", "population", "timeframe"],
            "properties": {
              "geography": {"type": ["string", "null"]},
              "population": {"type": ["string", "null"]},
              "timeframe": {"type": ["string", "null"]}
            }
          },
          "search_queries": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
